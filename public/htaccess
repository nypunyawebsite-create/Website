# .htaccess for Nypunya Aesthetics - SEO Optimization

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    # Force WWW or non-WWW (choose one)
    # Remove WWW (recommended for cleaner URLs)
    RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
    
    # Fix trailing slash issues
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !(.*)/$
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1/ [L,R=301]
    
    # Redirect old URLs to new URLs (301 Permanent Redirects)
    # Add your specific redirects here based on 404 errors from Search Console
    # Example:
    # Redirect 301 /old-page.html /new-page
    # Redirect 301 /services/old-service /new-service
    
    # Common fixes for WordPress to React migration
    Redirect 301 /index.php /
    Redirect 301 /index.html /
    
    # Fix 404 URLs - Specific redirects for broken links
    # Gallery page redirect
    RedirectMatch 301 ^/page/gallery/?$ /gallery
    
    # Terms and Policies redirect
    RedirectMatch 301 ^/terms-and-policies/?$ /privacy-policy
    
    # WordPress FAQ feed URLs - redirect to homepage
    RedirectMatch 301 ^/faq/.*/feed/?$ /
    
    # Block API subdomain requests (if accessed from main domain)
    RewriteCond %{HTTP_HOST} ^api\.nypunyaaesthetics\.com$ [NC]
    RewriteRule ^(.*)$ https://nypunyaaesthetics.com/ [R=301,L]
    
    # ============================================
    # NOINDEX PAGES FIXES - 92 Pages
    # ============================================
    
    # Block staging subdomain - redirect to main domain
    RewriteCond %{HTTP_HOST} ^staging\.nypunyaaesthetics\.com$ [NC]
    RewriteRule ^(.*)$ https://nypunyaaesthetics.com/ [R=301,L]
    
    # Block docs subdomain - redirect to main domain
    RewriteCond %{HTTP_HOST} ^docs\.nypunyaaesthetics\.com$ [NC]
    RewriteRule ^(.*)$ https://nypunyaaesthetics.com/ [R=301,L]
    
    # ============================================
    # QUERY PARAMETER CLEANUP - Remove tracking & WordPress params
    # Redirect URLs with tracking parameters to clean versions (no query string)
    # This ensures canonical URLs point to clean versions without query params
    # ============================================
    
    # Redirect URLs with WordPress page_id parameter to clean URL
    RewriteCond %{QUERY_STRING} .*page_id=.* [NC]
    RewriteRule ^(.*)$ /$1? [R=301,L]
    
    # Redirect URLs with WordPress post ID (p=) to clean URL
    RewriteCond %{QUERY_STRING} .*[?&]p=.* [NC]
    RewriteRule ^(.*)$ /$1? [R=301,L]
    
    # Redirect URLs with Facebook tracking (fbclid) to clean URL
    RewriteCond %{QUERY_STRING} .*fbclid=.* [NC]
    RewriteRule ^(.*)$ /$1? [R=301,L]
    
    # Redirect URLs with tracking parameters (source, city, category) to clean URL
    RewriteCond %{QUERY_STRING} .*(source|city|category)=.* [NC]
    RewriteRule ^(.*)$ /$1? [R=301,L]
    
    # Redirect URLs with UTM parameters to clean URL
    RewriteCond %{QUERY_STRING} .*utm_(source|medium|campaign|term|content)=.* [NC]
    RewriteRule ^(.*)$ /$1? [R=301,L]
    
    # Redirect URLs with other tracking parameters (gclid, ref) to clean URL
    RewriteCond %{QUERY_STRING} .*(gclid|ref)=.* [NC]
    RewriteRule ^(.*)$ /$1? [R=301,L]
    
    # ============================================
    # PAGE REDIRECTS - Old /pages/* structure
    # ============================================
    RedirectMatch 301 ^/pages/about-us/?$ /about-us
    RedirectMatch 301 ^/pages/contact-us/?$ /contact-us
    RedirectMatch 301 ^/pages/doctors/?$ /our-doctors
    RedirectMatch 301 ^/pages/testimonials/?$ /gallery
    RedirectMatch 301 ^/pages/career/?$ /
    RedirectMatch 301 ^/pages/?$ /
    
    # ============================================
    # SERVICE PAGE REDIRECTS
    # ============================================
    RedirectMatch 301 ^/breast-implants-faq/?$ /breast-enhancement
    RedirectMatch 301 ^/breast-augmentation/?$ /breast-enhancement
    RedirectMatch 301 ^/breast-augmentation-by-fat-transfer/?$ /breast-enhancement
    RedirectMatch 301 ^/breast-2/?$ /breast-enhancement
    RedirectMatch 301 ^/tummy-tuck/?$ /abdominal-contouring
    RedirectMatch 301 ^/body-contouring-abdomino-plasty/?$ /body-contouring
    RedirectMatch 301 ^/acne/?$ /acne-and-scars
    RedirectMatch 301 ^/chemical-peels/?$ /laser-skin-rejuvenation
    RedirectMatch 301 ^/patient-stories/?$ /gallery
    RedirectMatch 301 ^/under-eye-rejuvenation/?$ /anti-ageing
    RedirectMatch 301 ^/the-deep-plane-neck-lift/?$ /anti-ageing
    RedirectMatch 301 ^/antiaging-by-fat-grafting/?$ /structural-fat-grafting
    
    # Service landing pages redirects
    RedirectMatch 301 ^/expert-rhinoplasty-bangalore/?$ /rhinoplasty
    RedirectMatch 301 ^/rhinoplasty-lp/?$ /rhinoplasty
    RedirectMatch 301 ^/best-hair-transplant-treatment-in-bangalore/?$ /hair-transplant
    RedirectMatch 301 ^/affordable-laser-hair-removal-in-bangalore/?$ /laser-hair-removal
    RedirectMatch 301 ^/best-prp-treatment-in-bangalore/?$ /platelet-rich-plasma-injections
    RedirectMatch 301 ^/best-botox-treatment-in-bangalore/?$ /fillers-and-botox
    
    # ============================================
    # OLD WORDPRESS STRUCTURE REDIRECTS
    # ============================================
    
    # Testimonials - redirect to gallery
    RedirectMatch 301 ^/testimonial/.*$ /gallery
    
    # Author pages - redirect to homepage
    RedirectMatch 301 ^/author/admin/.*$ /
    RedirectMatch 301 ^/author/.*$ /
    
    # Category pages - redirect to services or homepage
    RedirectMatch 301 ^/category/plastic-surgery/.*$ /services
    RedirectMatch 301 ^/category/dermatology/.*$ /services
    RedirectMatch 301 ^/category/.*$ /services
    
    # Tag pages - redirect to homepage
    RedirectMatch 301 ^/tag/nursery/.*$ /
    RedirectMatch 301 ^/tag/nose/.*$ /rhinoplasty
    RedirectMatch 301 ^/tag/laser/.*$ /services
    RedirectMatch 301 ^/tag/.*$ /
    
    # FAQ pages - redirect to homepage (individual FAQs)
    RedirectMatch 301 ^/faq/.*$ /
    
    # Blog structure redirects
    RedirectMatch 301 ^/blog/blog-right-sidebar/.*$ /blogs
    RedirectMatch 301 ^/blog/page/.*$ /blogs
    RedirectMatch 301 ^/blog/?$ /blogs
    
    # Old service URLs
    RedirectMatch 301 ^/service/service-column-2/?$ /services
    RedirectMatch 301 ^/service/?$ /services
    RedirectMatch 301 ^/all-services/.*$ /services
    RedirectMatch 301 ^/all-services/?$ /services
    
    # Megamenu and other WordPress structures
    RedirectMatch 301 ^/megamenu/.*$ /
    RedirectMatch 301 ^/page_title/.*$ /
    
    # ============================================
    # OLD URL PATTERNS
    # ============================================
    RedirectMatch 301 ^/other-dermatology-services/?$ /services
    RedirectMatch 301 ^/all-services/privacy\.php$ /privacy-policy
    
    # React Router - Send all requests to index.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>

# Compression for faster loading
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType text/html "access plus 2 days"
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Prevent directory listing
Options -Indexes

